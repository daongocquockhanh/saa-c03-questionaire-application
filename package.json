{
  "name": "saa-c03-quiz-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "extract-pdf": "pdftotext -layout /Users/gondk/Downloads/SAA-C03.pdf data/saa-c03.txt",
    "parse": "node scripts/parse.js",
    "parse-aip": "node scripts/parse-examtopics-txt.js data/aip-c01 data/aip-c01/raw-questions.json",
    "parse-aip-sections": "node scripts/parse-sections.js data/aip-c01/sections.txt data/aip-c01/sections.json",
    "classify": "node scripts/classify.js",
    "build-tests": "node scripts/build-tests.js",
    "build-aip": "node scripts/build-exam-tests.js aip-c01",
    "build": "npm run extract-pdf && npm run parse && npm run classify && npm run build-tests",
    "test": "node --test scripts/*.test.js",
    "serve": "npx -y http-server public -p 8080 -c-1",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "^4.112.0"
  }
}
